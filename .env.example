# Excalidraw Environment Configuration Example

# Backend API URLs for scene storage
REACT_APP_BACKEND_V2_GET_URL=https://json.excalidraw.com/api/v2/
REACT_APP_BACKEND_V2_POST_URL=https://json.excalidraw.com/api/v2/post/

# Excalidraw Libraries
REACT_APP_LIBRARY_URL=https://libraries.excalidraw.com
REACT_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries

# Real-time Collaboration WebSocket Server (e.g., https://github.com/excalidraw/excalidraw-room)
REACT_APP_WS_SERVER_URL=http://localhost:3002

# Portal URL (set if using excalidraw.com portal workflow)
REACT_APP_PORTAL_URL=

# Firebase Configuration (for cloud persistence & rooms)
REACT_APP_FIREBASE_CONFIG='{"apiKey":"YOUR_FIREBASE_API_KEY","authDomain":"your-app.firebaseapp.com","projectId":"your-app","storageBucket":"your-app.appspot.com","messagingSenderId":"1234567890","appId":"1:1234567890:web:abcdef123456"}'

# Service Worker & Hot Reloading Flags
REACT_APP_DEV_ENABLE_SW=false
REACT_APP_DEV_DISABLE_LIVE_RELOAD=false
FAST_REFRESH=true

# Analytics (Optional)
REACT_APP_DISABLE_TRACKING=true
REACT_APP_DISABLE_SENTRY=true
